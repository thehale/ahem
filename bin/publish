#!/usr/bin/env bash
# Copyright (c) Joseph Hale, 2026
# SPDX-License-Identifier: MPL-2.0
#
# Usage: bin/publish [--dry-run]

set -euo pipefail

# shellcheck source=bin/lib/colors
source "$(dirname "${BASH_SOURCE[0]}")/lib/colors"

BRANCH="main"
RELEASE_TAG="^v[0-9]+\.[0-9]+\.[0-9]+$"

main() {
	refuse_automation
	confirm_checks
	confirm_branch
	confirm_clean_tree
	confirm_release_tag
	confirm_declared_origin
	confirm_pushed_branch
	confirm_pushed_tag
	publish "$@"
}

refuse_automation() {
	if [[ -n "${CI:-}" ]]; then
		refuse "CI publishes nothing. Run bin/publish from a workstation."
	fi
}

refuse() {
	red "$1" >&2
	exit 1
}

confirm_checks() {
	if ! bin/ci; then
		refuse "bin/ci failed. A release is cut from a checkout that passes."
	fi
}

confirm_branch() {
	local branch
	branch="$(git rev-parse --abbrev-ref HEAD)"

	if [[ "$branch" != "$BRANCH" ]]; then
		refuse "On $branch. A release is published from $BRANCH."
	fi
}

confirm_clean_tree() {
	if [[ -n "$(git status --porcelain)" ]]; then
		refuse "The working tree has changes. Commit them or put them aside."
	fi
}

confirm_release_tag() {
	local tag version
	tag="$(release_tag)"
	version="$(manifest version)"

	if [[ -z "$tag" ]]; then
		refuse "HEAD carries no vX.Y.Z tag. Tag the commit you mean to release."
	fi

	if [[ "$tag" != "v$version" ]]; then
		refuse "Tag $tag and Cargo.toml version $version name different releases."
	fi
}

release_tag() {
	git tag --points-at HEAD | grep --extended-regexp "$RELEASE_TAG" | head --lines 1 || true
}

manifest() {
	sed --quiet --regexp-extended "/^\[package\]/,/^\[/ s%^$1 = \"(.*)\"%\1%p" Cargo.toml
}

confirm_declared_origin() {
	local remote declared
	remote="$(git remote get-url origin)"
	declared="$(manifest repository)"

	if [[ "$declared" != "${remote%.git}" ]]; then
		refuse "Cargo.toml repository $declared is not origin ${remote%.git}."
	fi
}

confirm_pushed_branch() {
	local pushed
	pushed="$(remote_object "refs/heads/$BRANCH")"

	if [[ -z "$pushed" ]]; then
		refuse "origin has no $BRANCH. A release nobody can fetch is not a release."
	fi

	if [[ "$pushed" != "$(git rev-parse "HEAD^{}")" ]]; then
		refuse "origin/$BRANCH is a different commit. Send $BRANCH there first."
	fi
}

remote_object() {
	git ls-remote origin "$1" | cut --fields 1 | tail --lines 1
}

confirm_pushed_tag() {
	local tag pushed
	tag="$(release_tag)"
	pushed="$(remote_object "refs/tags/$tag")"

	if [[ -z "$pushed" ]]; then
		refuse "origin has no $tag. Send the tag there first."
	fi

	if [[ "$pushed" != "$(git rev-parse "refs/tags/$tag")" ]]; then
		refuse "origin's $tag is a different object than the local $tag."
	fi
}

publish() {
	local name version
	name="$(manifest name)"
	version="$(manifest version)"

	yellow "Publishing $name $version from $(release_tag)"
	cargo publish "$@"
	green "Published $name $version"
}

main "$@"
