#!/usr/bin/env bash
# Copyright (c) Joseph Hale, 2026
# SPDX-License-Identifier: MPL-2.0
#
# Usage: bin/markdownlint [--fix]

set -euo pipefail

GLOBS=(
	"**/*.md"
	"**/*.markdown"
	"!vendor/**"
)

CONFIG='
# no-inline-html
MD033: false

# first-line-heading
MD041: false
'

CONFIG_DIR=""

main() {
	trap cleanup EXIT
	write_config
	markdownlint-cli2 --config "$CONFIG_DIR/.markdownlint.yaml" "$@" "${GLOBS[@]}"
}

write_config() {
	CONFIG_DIR="$(mktemp --directory)"
	printf '%s\n' "$CONFIG" >"$CONFIG_DIR/.markdownlint.yaml"
}

cleanup() {
	if [[ -n "$CONFIG_DIR" ]]; then
		rm --recursive --force "$CONFIG_DIR"
	fi
}

main "$@"
