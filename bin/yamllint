# Usage: filelike yaml | bin/yamllint

set -euo pipefail

CONFIG='
rules:
  line-length:
    max: 80
    allow-non-breakable-inline-mappings: true
'

xargs --no-run-if-empty "$(mise which yamllint)" --config-data "$CONFIG"
