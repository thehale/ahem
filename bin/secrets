#!/usr/bin/env bash
# Copyright (c) Joseph Hale, 2026
# SPDX-License-Identifier: MPL-2.0
#
# Usage: bin/secrets [--verbose]

set -euo pipefail

CONFIG='
[extend]
useDefault = true
'

CONFIG_DIR=""

main() {
	trap cleanup EXIT
	write_config
	scan "$@"
}

write_config() {
	CONFIG_DIR="$(mktemp --directory)"
	printf '%s\n' "$CONFIG" >"$CONFIG_DIR/.gitleaks.toml"
}

scan() {
	gitleaks git --no-banner --redact --config "$CONFIG_DIR/.gitleaks.toml" "$@"
}

cleanup() {
	if [[ -n "$CONFIG_DIR" ]]; then
		rm --recursive --force "$CONFIG_DIR"
	fi
}

main "$@"
