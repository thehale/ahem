set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$HERE")"
CACHE="$ROOT/.cache"

# shellcheck source=src/lib/cache
source "$HERE/lib/cache"
# shellcheck source=src/lib/classify
source "$HERE/lib/classify"
# shellcheck source=src/lib/grammar
source "$HERE/lib/grammar"
# shellcheck source=src/lib/compile
source "$HERE/lib/compile"
# shellcheck source=src/lib/config
source "$HERE/lib/config"

function main() {
	AST_GREP="$(tool ast-grep)"
	JQ="$(tool jq)"
	SCC="$(tool scc)"
	YQ="$(tool yq)"
	case "${1:-check}" in
	check) check "${@:2}" ;;
	rules) rules ;;
	compile) compile "${2:-}" ;;
	test) verify ;;
	*) usage ;;
	esac
}

function tool() {
	local path
	path="$(cd "$ROOT" && mise which "$1")"
	if [[ ! -x "$path" ]]; then
		printf 'deconfuse needs %s. Run mise install in %s.\n' "$1" "$ROOT" >&2
		exit 1
	fi
	echo "$path"
}

function check() {
	local language
	classified "$@" >"$CACHE/sorted"
	scan "" "$(grep '^	' "$CACHE/sorted" | cut -f2-)"
	cut -f1 "$CACHE/sorted" | grep -v '^$' | sort -u | while read -r language; do
		scan "$language" "$(grep "^$language	" "$CACHE/sorted" | cut -f2-)"
	done
}

function scan() {
	local files
	mapfile -t files <<<"$2"
	if [[ -n "${files[0]}" ]]; then
		"$AST_GREP" scan --config "$(configure "$1")" "${files[@]}"
	fi
}

function rules() {
	local rule
	for rule in "$ROOT"/rules/*.yml; do
		printf '%s  %s  %s\n' "$("$YQ" '.id' "$rule")" "$("$YQ" '.severity' "$rule")" "$(languages "$rule" | tr '\n' ' ')"
	done
}

function compile() {
	local matcher
	configure "" >/dev/null
	for matcher in "$CACHE"/rules/"${1:-}"*.yml; do
		printf '%s\n' "--- $matcher"
		cat "$matcher"
	done
}

function verify() {
	"$AST_GREP" test --config "$(configure "")" --skip-snapshot-tests
}

function usage() {
	printf 'usage: deconfuse [check PATH... | rules | compile [RULE] | test]\n' >&2
	exit 1
}

main "$@"
